node_modules/
.env
uploads/*
!uploads/.gitkeep
*.log

# Persistent recording history - real user audio/DB data, never committed
data/
recordings/*
!recordings/.gitkeep

# Generated internal mTLS certs/keys - never commit real key material
certs/

# Local Claude Code tool-permission cache, not project config
.claude/

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Model caches (mounted volumes in production, never committed)
ai-services/*/models/
