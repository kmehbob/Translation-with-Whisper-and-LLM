# Copy to .env and fill in real values. Never commit the real .env file.

# ---------------------------------------------------------------------------
# Gateway (Node/Express)
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# Rollback lever: set to false to instantly disable the transcribe/translate
# routes (503) without touching any other part of the app.
ENABLE_AI_FEATURES=true

# Comma-separated list of origins allowed to call the API cross-origin.
# Leave empty to allow same-origin browser requests only (the default UI).
ALLOWED_ORIGINS=

# Optional API-key gate for the public transcribe/translate endpoints. Off
# by default (this is an unauthenticated public tool today). Turn on for an
# internal/enterprise deployment, ideally behind a reverse proxy that also
# enforces SSO.
REQUIRE_CLIENT_API_KEY=false
CLIENT_API_KEY=

# Shared secret between the gateway and the two Python AI services. Generate
# with: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=change-me-to-a-long-random-value

# Internal AI service endpoints (Docker Compose service names in production).
# Use https:// once INTERNAL_TLS_ENABLED=true below (docker-compose.yml
# already does both together).
TRANSCRIPTION_SERVICE_URL=http://localhost:8001
TRANSLATION_SERVICE_URL=http://localhost:8002

# Mutual TLS between the gateway and the two AI services. Off by default for
# a zero-config native/bare-metal run; docker-compose.yml turns this on and
# supplies certs generated by ./scripts/generate-internal-certs.sh. Any real
# (non-dev) deployment should enable this - see docs/AI_FEATURE.md.
INTERNAL_TLS_ENABLED=false
INTERNAL_TLS_CLIENT_CERT_FILE=./certs/gateway-client.crt
INTERNAL_TLS_CLIENT_KEY_FILE=./certs/gateway-client.key
INTERNAL_TLS_CA_FILE=./certs/ca.crt

# Timeouts (ms)
TRANSCRIBE_TIMEOUT_MS=120000
TRANSLATE_TIMEOUT_MS=30000
AI_HEALTH_TIMEOUT_MS=3000

# Input limits
MAX_AUDIO_UPLOAD_MB=100
MAX_TRANSLATE_TEXT_LENGTH=20000

# Gateway-side concurrency guards (defense in depth on top of the per-service
# semaphores below)
MAX_CONCURRENT_TRANSCRIBE_REQUESTS=4
MAX_CONCURRENT_TRANSLATE_REQUESTS=8

# Rate limiting (per client IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_TRANSCRIBE_MAX=10
RATE_LIMIT_TRANSLATE_MAX=20
RATE_LIMIT_GENERAL_MAX=60

LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Transcription service (ai-services/transcription)
# ---------------------------------------------------------------------------
# NOTE on SERVICE_PORT / MODEL_CACHE_DIR: docker-compose.yml loads this SAME
# file into both AI service containers via `env_file`, so a key can only
# have one value across both of them from this file alone - that's why
# docker-compose.yml sets SERVICE_PORT and MODEL_CACHE_DIR explicitly per
# service under each service's own `environment:` block (those take
# precedence over whatever is set here). The values below are what apply if
# you instead run a service natively/bare-metal (see docs/AI_FEATURE.md §5),
# where each service is its own process with its own environment.
SERVICE_PORT=8001
# INTERNAL_SERVICE_TOKEN is shared with the gateway value above.

# tiny | base | small | medium | large-v3  - see docs/AI_FEATURE.md for the
# VRAM-tiered recommendation table.
WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_BEAM_SIZE=5
WHISPER_LANGUAGE=ur
WHISPER_VAD_FILTER=true
MODEL_CACHE_DIR=/models/whisper
MAX_CONCURRENT_TRANSCRIPTIONS=2

# Server-side of the same mTLS link (see INTERNAL_TLS_ENABLED above). Off by
# default; docker-compose.yml enables it and points these at the certs
# generated by ./scripts/generate-internal-certs.sh.
TLS_ENABLED=false
TLS_CERT_FILE=./certs/transcription-server.crt
TLS_KEY_FILE=./certs/transcription-server.key
TLS_CLIENT_CA_FILE=./certs/ca.crt

# ---------------------------------------------------------------------------
# Translation service (ai-services/translation)
# ---------------------------------------------------------------------------
# Under Docker Compose, docker-compose.yml overrides these to 8002 /
# /models/translation for this service regardless of what's above. Running
# this service natively/bare-metal instead? It's a separate process with its
# own environment, so give it these two instead of the transcription
# service's values above:
#   SERVICE_PORT=8002
#   MODEL_CACHE_DIR=/models/translation
# INTERNAL_SERVICE_TOKEN is shared with the gateway value above.

TRANSLATION_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
TRANSLATION_DEVICE=auto
# auto | fp32 | fp16 | bf16 | int8 | int4 - see docs/AI_FEATURE.md
TRANSLATION_PRECISION=auto
MAX_CONTEXT_TOKENS=4096
MAX_NEW_TOKENS=1024
MAX_INPUT_TOKENS_PER_CHUNK=700
MAX_CONCURRENT_TRANSLATIONS=2
TEMPERATURE=0.1
TOP_P=0.9
DO_SAMPLE=false
WARMUP_ON_STARTUP=true

# Server-side mTLS for this service. Under Docker Compose these point at
# translation-server.crt/.key instead of transcription's - see the note
# above and docker-compose.yml.
TLS_ENABLED=false
TLS_CERT_FILE=./certs/translation-server.crt
TLS_KEY_FILE=./certs/translation-server.key
TLS_CLIENT_CA_FILE=./certs/ca.crt

# ---------------------------------------------------------------------------
# Public reverse proxy (optional - deploy/Caddyfile, `--profile proxy`)
# ---------------------------------------------------------------------------
# A real domain with DNS already pointing at this host - Caddy will
# automatically obtain and renew a Let's Encrypt certificate for it. Leave
# as "localhost" for internal/testing use only (not a publicly trusted cert).
PUBLIC_DOMAIN=localhost

# ---------------------------------------------------------------------------
# Tests (optional - only used by the gated integration test suites)
# ---------------------------------------------------------------------------
# Set to 1 to run `npm run test:integration` / pytest against the REAL
# models instead of skipping. Requires the actual GPU services to be up.
RUN_GPU_INTEGRATION_TESTS=0
# Path to a real Urdu .wav sample, used only by the transcription integration test.
SAMPLE_URDU_AUDIO_PATH=
